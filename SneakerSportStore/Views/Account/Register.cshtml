@model SneakerSportStore.Models.RegisterModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <title>Đăng ký - SneakerSportStore</title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        body{
            background:#f4f6ff;
            font-family:system-ui,-apple-system,"Segoe UI",Roboto;
            min-height:100vh;
            display:flex;
            align-items:center;
            justify-content:center;
            padding:20px
        }
        .auth-container{
            width:100%;
            max-width:520px;
            background:#fff;
            border-radius:20px;
            box-shadow:0 12px 35px -10px rgba(31,42,98,.15);
            overflow:hidden;
            position:relative;
        }
        .auth-header{
            background:linear-gradient(135deg,#4361ee,#3a0ca3);
            color:#fff;
            padding:32px 30px 28px;
            text-align:center;
        }
        .auth-logo{font-size:1.8rem;font-weight:700;margin-bottom:6px}
        .step-indicator{
            display:flex;
            justify-content:center;
            gap:36px;
            padding:18px 0 4px;
            background:#fff;
        }
        .step{
            width:38px;height:38px;
            border-radius:50%;
            background:#e9ecef;
            color:#5f6368;
            font-weight:600;
            display:flex;align-items:center;justify-content:center;
            position:relative;
            transition:.25s;
        }
        .step.active{
            background:#4361ee;
            color:#fff;
            box-shadow:0 4px 10px rgba(67,97,238,.4);
        }
        .step .step-text{
            position:absolute;
            top:46px;
            left:50%;transform:translateX(-50%);
            font-size:.7rem;
            white-space:nowrap;
            color:#6c757d;
        }
        .step.active .step-text{color:#4361ee;font-weight:600}
        .auth-content{padding:34px 34px 40px}
        .form-group{margin-bottom:18px;position:relative}
        .form-icon{
            position:absolute;top:50%;left:14px;
            transform:translateY(-50%);
            color:#6c757d;opacity:.6;font-size:.95rem;
        }
        .form-control{
            padding-left:44px;
            height:50px;
            border:2px solid #dee2e6;
            border-radius:12px;
            transition:.25s;
        }
        .form-control:focus{
            border-color:#4361ee;
            box-shadow:0 0 0 .2rem rgba(67,97,238,.15);
        }
        .btn-primary{
            background:#4361ee;
            border:none;
            height:50px;
            border-radius:12px;
            font-weight:600;
        }
        .btn-primary:disabled{
            opacity:.65;
        }
        .btn-secondary{
            height:50px;
            border:none;
            border-radius:12px;
            font-weight:600;
        }
        .otp-container{
            display:flex;
            gap:12px;
        }
        .otp-input{
            width:54px;height:54px;
            text-align:center;
            font-size:1.35rem;
            border:2px solid #dee2e6;
            border-radius:12px;
            font-weight:600;
            transition:.25s;
        }
        .otp-input:focus{
            outline:none;
            border-color:#4361ee;
            box-shadow:0 0 0 .2rem rgba(67,97,238,.15);
        }
        .hidden-section{display:none;}
        .alert{border-radius:14px}
        .resend-otp a{ text-decoration:none }
        .resend-otp a.disabled{pointer-events:none;opacity:.5}
        .is-invalid + .invalid-feedback{display:block}
        .invalid-feedback{font-size:.8rem}
        .status-line{font-size:.85rem;margin-top:6px;min-height:20px}
        .spinner-border{--bs-spinner-width:1rem;--bs-spinner-height:1rem;--bs-spinner-border-width: .15em;}
        .success-animation .checkmark{
            width:86px;height:86px;border-radius:50%;
            background:linear-gradient(135deg,#4cc9f0,#4361ee);
            display:flex;align-items:center;justify-content:center;
            color:#fff;font-size:2.4rem;margin:0 auto 18px;
            box-shadow:0 10px 25px -8px rgba(67,97,238,.6);
        }
        .terms-text a{color:#4361ee}
        .toast-zone{position:fixed;top:16px;right:16px;z-index:1055;display:flex;flex-direction:column;gap:10px}
        .toast-msg{
            padding:10px 14px;border-radius:10px;
            font-size:.85rem;font-weight:500;
            background:#4361ee;color:#fff;
            animation:fadeSlide .4s ease;
            box-shadow:0 4px 16px -6px rgba(0,0,0,.25);
        }
        .toast-msg.error{background:#e63946}
        .toast-msg.success{background:#1cc88a}
        keyframes fadeSlide{
            from{opacity:0;transform:translateY(-6px)}
            to{opacity:1;transform:translateY(0)}
        }
    </style>
</head>
<body>
    <div class="toast-zone" id="toastZone"></div>

    <div class="auth-container">
        <div class="auth-header">
            <div class="auth-logo">SneakerSportStore</div>
            <h2 class="auth-title">Đăng ký tài khoản</h2>
        </div>

        <div class="step-indicator mb-3">
            <div class="step active" id="step1Indicator">1<span class="step-text">Email</span></div>
            <div class="step" id="step2Indicator">2<span class="step-text">OTP</span></div>
            <div class="step" id="step3Indicator">3<span class="step-text">Thông tin</span></div>
        </div>

        <div class="auth-content">

            <!-- STEP 1 -->
            <div id="step1Section">
                <div class="alert alert-info mb-4">
                    <i class="fas fa-info-circle me-2"></i>Nhập email để kiểm tra và nhận mã OTP.
                </div>
                <div class="form-group">
                    <i class="fas fa-envelope form-icon"></i>
                    <input type="email" id="email" class="form-control" placeholder="Email của bạn" autocomplete="off" />
                    <div id="emailFeedback" class="invalid-feedback"></div>
                </div>
                <button type="button" id="checkEmailBtn" class="btn btn-primary w-100">
                    Kiểm tra &amp; Gửi mã OTP
                </button>
                <div id="emailStatus" class="status-line text-muted"></div>
            </div>

            <!-- STEP 2 -->
            <div id="step2Section" class="hidden-section">
                <div class="alert alert-info mb-4">
                    <i class="fas fa-envelope me-2"></i>
                    Mã OTP đã gửi tới: <strong id="userEmail"></strong>
                </div>

                <div class="form-group text-center mb-3">
                    <label class="form-label fw-semibold mb-2">Nhập mã OTP (6 số)</label>
                    <div class="otp-container justify-content-center mb-2">
                        <input class="otp-input" maxlength="1" data-index="1" inputmode="numeric" />
                        <input class="otp-input" maxlength="1" data-index="2" inputmode="numeric" />
                        <input class="otp-input" maxlength="1" data-index="3" inputmode="numeric" />
                        <input class="otp-input" maxlength="1" data-index="4" inputmode="numeric" />
                        <input class="otp-input" maxlength="1" data-index="5" inputmode="numeric" />
                        <input class="otp-input" maxlength="1" data-index="6" inputmode="numeric" />
                    </div>
                    <div id="otpFeedback" class="text-danger small" style="display:none;"></div>
                </div>

                <div class="resend-otp text-center mb-3">
                    <a href="#" id="resendOtpBtn">Gửi lại mã</a> (<span id="countdown">0</span>s)
                </div>

                <button id="verifyOtpBtn" class="btn btn-primary w-100 mb-2">Xác thực OTP</button>
                <button id="backToEmailBtn" class="btn btn-secondary w-100">
                    <i class="fas fa-arrow-left me-2"></i>Quay lại Email
                </button>
            </div>

            <!-- STEP 3 -->
            <div id="step3Section" class="hidden-section">
                <div class="alert alert-success mb-4">
                    <i class="fas fa-check-circle me-2"></i>OTP hợp lệ – hãy hoàn tất thông tin.
                </div>

                @* Form cuối để có AntiForgery *@
                <form id="finalForm">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="Email" id="finalEmail" />

                    <div class="form-group">
                        <i class="fas fa-user form-icon"></i>
                        <input type="text" class="form-control" name="HoTen" id="hoTen" placeholder="Họ và tên" />
                        <div class="invalid-feedback">Vui lòng nhập họ tên.</div>
                    </div>
                    <div class="form-group">
                        <i class="fas fa-user-tag form-icon"></i>
                        <input type="text" class="form-control" name="TenDangNhap" id="tenDangNhap" placeholder="Tên đăng nhập" />
                        <div class="invalid-feedback">Vui lòng nhập tên đăng nhập.</div>
                    </div>
                    <div class="form-group">
                        <i class="fas fa-lock form-icon"></i>
                        <input type="password" class="form-control" name="Password" id="password" placeholder="Mật khẩu (>=8 ký tự)" />
                        <div class="invalid-feedback">Mật khẩu tối thiểu 8 ký tự.</div>
                    </div>
                    <div class="form-group">
                        <i class="fas fa-lock form-icon"></i>
                        <input type="password" class="form-control" name="ConfirmPassword" id="confirmPassword" placeholder="Xác nhận mật khẩu" />
                        <div class="invalid-feedback">Mật khẩu xác nhận không khớp.</div>
                    </div>
                    <div class="form-group">
                        <i class="fas fa-phone form-icon"></i>
                        <input type="tel" class="form-control" name="SoDienThoai" id="soDienThoai" placeholder="Số điện thoại" />
                    </div>
                    <div class="form-group">
                        <i class="fas fa-map-marker-alt form-icon"></i>
                        <textarea class="form-control" name="DiaChi" id="diaChi" placeholder="Địa chỉ" rows="2"></textarea>
                    </div>

                    <div class="form-check mb-3">
                        <input type="checkbox" id="terms" class="form-check-input" />
                        <label for="terms" class="form-check-label terms-text">
                            Tôi đồng ý với <a href="#">Điều khoản</a> &amp; <a href="#">Chính sách bảo mật</a>.
                        </label>
                    </div>

                    <button type="button" id="submitRegisterBtn" class="btn btn-primary w-100 mb-2">
                        Hoàn tất đăng ký
                    </button>
                    <button type="button" id="backToOtpBtn" class="btn btn-secondary w-100">
                        <i class="fas fa-arrow-left me-2"></i>Quay lại OTP
                    </button>
                </form>
            </div>

            <!-- STEP 4 -->
            <div id="step4Section" class="hidden-section text-center">
                <div class="success-animation mb-3">
                    <div class="checkmark"><i class="fas fa-check"></i></div>
                </div>
                <h3 class="text-success fw-bold mb-3">Đăng ký thành công!</h3>
                <p class="mb-4">Bạn có thể đăng nhập ngay bây giờ.</p>
                <a href="/Account/Login" class="btn btn-primary w-100">
                    <i class="fas fa-sign-in-alt me-2"></i>Đăng nhập
                </a>
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
/* ---------- Helper UI ---------- */
function showToast(msg, type='info'){
    const zone=document.getElementById('toastZone');
    const div=document.createElement('div');
    div.className='toast-msg '+(type==='error'?'error':type==='success'?'success':'');
    div.textContent=msg;
    zone.appendChild(div);
    setTimeout(()=>{div.style.opacity='0';setTimeout(()=>div.remove(),400)},4000);
}

function validateEmailFormat(e) {
    return /^[\w.+-]+@@[\w-]+\.[\w.-]{2,}$/i.test(e);
}

/* ---------- DOM refs ---------- */
const step1 = document.getElementById('step1Section');
const step2 = document.getElementById('step2Section');
const step3 = document.getElementById('step3Section');
const step4 = document.getElementById('step4Section');
const ind1 = document.getElementById('step1Indicator');
const ind2 = document.getElementById('step2Indicator');
const ind3 = document.getElementById('step3Indicator');

const emailInput = document.getElementById('email');
const emailFeedback = document.getElementById('emailFeedback');
const emailStatus = document.getElementById('emailStatus');
const checkEmailBtn = document.getElementById('checkEmailBtn');
const userEmailEl = document.getElementById('userEmail');
const resendBtn = document.getElementById('resendOtpBtn');
const verifyOtpBtn = document.getElementById('verifyOtpBtn');
const backToEmailBtn = document.getElementById('backToEmailBtn');
const backToOtpBtn = document.getElementById('backToOtpBtn');
const otpFeedback = document.getElementById('otpFeedback');
const countdownEl = document.getElementById('countdown');
const otpInputs = document.querySelectorAll('.otp-input');

const finalEmail = document.getElementById('finalEmail');
const hoTenInput = document.getElementById('hoTen');
const tenDangNhapInput = document.getElementById('tenDangNhap');
const passwordInput = document.getElementById('password');
const confirmPasswordInput = document.getElementById('confirmPassword');
const soDienThoaiInput = document.getElementById('soDienThoai');
const diaChiInput = document.getElementById('diaChi');
const termsCheckbox = document.getElementById('terms');
const submitRegisterBtn = document.getElementById('submitRegisterBtn');
const finalForm = document.getElementById('finalForm');

let currentEmail = '';
let cooldown = 0;
let timer = null;
let otpVerified = false;

/* ---------- Steps ---------- */
function showStep(n){
    [step1,step2,step3,step4].forEach(s=>s.classList.add('hidden-section'));
    [ind1,ind2,ind3].forEach(i=>i.classList.remove('active'));
    if(n===1){ step1.classList.remove('hidden-section'); ind1.classList.add('active'); }
    if(n===2){ step2.classList.remove('hidden-section'); ind2.classList.add('active'); }
    if(n===3){ step3.classList.remove('hidden-section'); ind3.classList.add('active'); }
    if(n===4){ step4.classList.remove('hidden-section'); }
}

function startCooldown(seconds){
    cooldown = seconds;
    updateCountdown();
    if(timer) clearInterval(timer);
    timer = setInterval(()=>{
        cooldown--;
        updateCountdown();
        if(cooldown<=0){ clearInterval(timer); }
    },1000);
}
function updateCountdown(){
    countdownEl.textContent = cooldown<0?0:cooldown;
    if(cooldown>0){
        resendBtn.classList.add('disabled');
    }else{
        resendBtn.classList.remove('disabled');
    }
}

function collectOtp(){
    let c='';
    otpInputs.forEach(i=>c+=i.value.trim());
    return c;
}

function setEmailError(msg){
    emailInput.classList.add('is-invalid');
    emailFeedback.textContent = msg;
}
function clearEmailError(){
    emailInput.classList.remove('is-invalid');
    emailFeedback.textContent='';
}

/* ---------- Generic POST JSON ---------- */
async function postJson(url,data){
    const res = await fetch(url,{
        method:'POST',
        headers:{
            'Content-Type':'application/json',
            'X-Requested-With':'XMLHttpRequest'
        },
        body: JSON.stringify(data)
    });
    return await res.json();
}

/* ---------- STEP 1: Check + Send OTP ---------- */
checkEmailBtn.addEventListener('click', async ()=>{
    const email = emailInput.value.trim().toLowerCase();
    if(!email){ setEmailError('Vui lòng nhập email.'); return; }
    if(!validateEmailFormat(email)){ setEmailError('Email không hợp lệ.'); return; }
    clearEmailError();
    emailStatus.textContent='';
    checkEmailBtn.disabled=true;
    checkEmailBtn.innerHTML='<span class="spinner-border spinner-border-sm me-2"></span>Đang xử lý...';

    try{
        // 1. CheckEmail
        const chk = await postJson('/Account/CheckEmail',{ email });
        if(chk.exists){
            setEmailError('Email này đã được đăng ký.');
            checkEmailBtn.disabled=false;
            checkEmailBtn.textContent='Kiểm tra & Gửi mã OTP';
            return;
        }

        // 2. SendOtp
        const send = await postJson('/Account/SendOtp',{ email });
        if(!send.success){
            setEmailError(send.message || 'Không gửi được OTP.');
            checkEmailBtn.disabled=false;
            checkEmailBtn.textContent='Kiểm tra & Gửi mã OTP';
            return;
        }

        currentEmail = email;
        userEmailEl.textContent = email;
        finalEmail.value = email;
        otpInputs.forEach(i=>i.value='');
        otpFeedback.style.display='none';
        otpVerified=false;
        startCooldown(send.cooldown || 30);
        showToast('OTP đã gửi.', 'success');
        showStep(2);
    }catch(err){
        setEmailError('Lỗi hệ thống: '+ err.message);
    }finally{
        checkEmailBtn.disabled=false;
        checkEmailBtn.textContent='Kiểm tra & Gửi mã OTP';
    }
});

/* ---------- OTP input auto move ---------- */
otpInputs.forEach(inp=>{
    inp.addEventListener('input', e=>{
        e.target.value=e.target.value.replace(/\\D/g,'').slice(0,1);
        const idx=parseInt(e.target.dataset.index);
        if(e.target.value && idx<6){
            const next=document.querySelector('.otp-input[data-index="'+(idx+1)+'"]');
            next && next.focus();
        }
    });
    inp.addEventListener('keydown', e=>{
        if(e.key==='Backspace' && !e.target.value){
            const idx=parseInt(e.target.dataset.index);
            if(idx>1){
                const prev=document.querySelector('.otp-input[data-index="'+(idx-1)+'"]');
                prev && prev.focus();
            }
        }
    });
});

/* ---------- Resend OTP ---------- */
resendBtn.addEventListener('click', async e=>{
    e.preventDefault();
    if(cooldown>0 || !currentEmail) return;
    resendBtn.classList.add('disabled');
    const r = await postJson('/Account/ResendOtp',{ email: currentEmail });
    if(r.success){
        showToast('Đã gửi lại OTP.','success');
        startCooldown(r.cooldown || 30);
    }else{
        showToast(r.message || 'Không gửi lại OTP được.','error');
        resendBtn.classList.remove('disabled');
    }
});

/* ---------- Back to Email ---------- */
backToEmailBtn.addEventListener('click', ()=>{
    currentEmail='';
    showStep(1);
});

/* ---------- Verify OTP ---------- */
verifyOtpBtn.addEventListener('click', async ()=>{
    const code = collectOtp();
    if(code.length!==6){
        otpFeedback.textContent='Vui lòng nhập đủ 6 số.';
        otpFeedback.style.display='block';
        return;
    }
    otpFeedback.style.display='none';
    verifyOtpBtn.disabled=true;
    verifyOtpBtn.innerHTML='<span class="spinner-border spinner-border-sm me-2"></span>Đang kiểm tra...';

    try{
        const res = await postJson('/Account/VerifyOtpAjax',{ email: currentEmail, otp: code });
        if(!res.success){
            otpFeedback.textContent = res.message || 'OTP không đúng.';
            otpFeedback.style.display='block';
        }else{
            otpVerified=true;
            showToast('OTP hợp lệ.','success');
            showStep(3);
        }
    }catch(err){
        otpFeedback.textContent='Lỗi hệ thống: '+err.message;
        otpFeedback.style.display='block';
    }finally{
        verifyOtpBtn.disabled=false;
        verifyOtpBtn.textContent='Xác thực OTP';
    }
});

/* ---------- Back to OTP from details ---------- */
backToOtpBtn.addEventListener('click', ()=>{
    if(!currentEmail){ showStep(1); return; }
    showStep(2);
});

/* ---------- Form validations ---------- */
function markInvalid(el,msg){
    el.classList.add('is-invalid');
    const fb = el.parentElement.querySelector('.invalid-feedback');
    if(fb) fb.textContent = msg;
}
function clearInvalid(el){
    el.classList.remove('is-invalid');
}

function validateDetails(){
    let ok=true;
    if(!hoTenInput.value.trim()){ markInvalid(hoTenInput,'Vui lòng nhập họ tên'); ok=false; } else clearInvalid(hoTenInput);
    if(!tenDangNhapInput.value.trim()){ markInvalid(tenDangNhapInput,'Vui lòng nhập tên đăng nhập'); ok=false; } else clearInvalid(tenDangNhapInput);
    if(passwordInput.value.length<8){ markInvalid(passwordInput,'Mật khẩu tối thiểu 8 ký tự'); ok=false; } else clearInvalid(passwordInput);
    if(confirmPasswordInput.value !== passwordInput.value || !confirmPasswordInput.value){
        markInvalid(confirmPasswordInput,'Mật khẩu xác nhận không khớp'); ok=false;
    } else clearInvalid(confirmPasswordInput);
    if(!termsCheckbox.checked){ showToast('Bạn phải đồng ý điều khoản.', 'error'); ok=false; }
    if(!otpVerified){ showToast('Bạn chưa xác thực OTP.', 'error'); ok=false; }
    return ok;
}

/* ---------- Complete Registration ---------- */
submitRegisterBtn.addEventListener('click', async ()=>{
    if(!validateDetails()) return;
    submitRegisterBtn.disabled=true;
    submitRegisterBtn.innerHTML='<span class="spinner-border spinner-border-sm me-2"></span>Đang tạo...';

    try{
        const fd = new FormData(finalForm);
        const res = await fetch('/Account/CompleteRegistration',{
            method:'POST',
            body: fd
        }).then(r=>r.json());

        if(!res.success){
            showToast(res.message || 'Đăng ký thất bại.','error');
        }else{
            showToast('Đăng ký thành công!','success');
            showStep(4);
        }
    }catch(err){
        showToast('Lỗi hệ thống: '+err.message,'error');
    }finally{
        submitRegisterBtn.disabled=false;
        submitRegisterBtn.textContent='Hoàn tất đăng ký';
    }
});

/* ---------- Simple password instant check ---------- */
passwordInput.addEventListener('input', ()=>{
    if(passwordInput.value && passwordInput.value.length<8) passwordInput.classList.add('is-invalid');
    else passwordInput.classList.remove('is-invalid');
    if(confirmPasswordInput.value && confirmPasswordInput.value!==passwordInput.value)
        confirmPasswordInput.classList.add('is-invalid');
    else confirmPasswordInput.classList.remove('is-invalid');
});
confirmPasswordInput.addEventListener('input', ()=>{
    if(confirmPasswordInput.value!==passwordInput.value) confirmPasswordInput.classList.add('is-invalid');
    else confirmPasswordInput.classList.remove('is-invalid');
});
    </script>
</body>
</html>
