@model SneakerSportStore.Models.UserInfo

<div class="container py-5">
    <h2 class="mb-4">Chỉnh sửa thông tin cá nhân</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form method="post" action="@Url.Action("EditProfile")">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label>Họ và tên</label>
            <input type="text" class="form-control" name="HoTen" value="@Model.HoTen" required>
        </div>

        <div class="form-group">
            <label>Email</label>
            <input type="email" class="form-control" name="Email" value="@Model.Email" required>
        </div>

        <div class="form-group">
            <label>Số điện thoại</label>
            <input type="tel" class="form-control" name="SoDienThoai" value="@Model.SoDienThoai">
        </div>

        <div class="form-group">
            <label>Địa chỉ</label>
            <textarea class="form-control" name="DiaChi">@Model.DiaChi</textarea>
        </div>

        <button type="submit" class="btn btn-primary">Cập nhật</button>
    </form>
</div>